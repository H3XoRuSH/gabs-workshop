---
// Competitive Programming — framed "for fun", mono face as a nod to CP culture.
// Links only, no stats (Gab's choice).
import Card from '../Card.astro';

const cpCode = `// origin: NOI.PH, high school
// ongoing: Codeforces + AtCoder
while (contest.exists()) {
  solve(); // "one more problem" — famous last words
}`;
---

<section id="cp" class="section">
  <div class="container">
    <div class="section-head">
      <h2 class="section-title">Competitive Programming</h2>
      <span class="tag-chip tag-chip--green">for fun, not for padding</span>
    </div>

    <div class="cp-grid">
      <Card accent="green" title="Still solving, still learning">
        <p class="cp-intro">
          Competitive programming is what I do when I'm not shipping web apps. It started
          with NOI.PH back in high school — the habit stuck, and the algorithmic instincts
          show up in everything else I build.
        </p>
        <pre class="cp-code">{cpCode}</pre>
        <div class="cp-links">
          <a class="btn" href="https://codeforces.com/profile/H3XoRuSH" target="_blank" rel="noopener noreferrer">
            Codeforces ↗
          </a>
          <a class="btn btn--ink" href="https://atcoder.jp/users/H3XoRuSH" target="_blank" rel="noopener noreferrer">
            AtCoder ↗
          </a>
        </div>
      </Card>
    </div>
  </div>
</section>

<style>
  .cp-grid {
    max-width: 720px;
  }

  .cp-grid :global(.card) {
    font-family: var(--font-mono);
  }

  .cp-intro {
    font-size: 0.92rem;
    line-height: 1.7;
  }

  .cp-code {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    line-height: 1.8;
    margin: 0 0 1.25rem;
    padding: 0.9rem 1rem;
    border: 2px solid var(--ink);
    border-radius: 2px;
    background: rgba(26, 26, 26, 0.04);
    overflow-x: auto;
  }

  .cp-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.7rem;
  }
</style>
